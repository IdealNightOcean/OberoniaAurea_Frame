<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OberoniaAurea_Frame</RootNamespace>
    <AssemblyName>OberoniaAurea_Frame</AssemblyName>
    <Deterministic>true</Deterministic>
    <!-- 保留现有 Properties\AssemblyInfo.cs，禁止 SDK 自动生成重复的程序集特性 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>Release\</OutputPath>
  </PropertyGroup>

  <!-- 定义Mod输出根路径，带[]特殊字符，单独放属性 -->
  <PropertyGroup>
    <RimWorldModAssemblyDir>E:\ProgramFiles\Steam\steamapps\common\RimWorld\Mods\[OA]Oberonia Aurea Framework\1.7\Assemblies</RimWorldModAssemblyDir>
  </PropertyGroup>

  <!-- 引用暂未迁移：0Harmony、Assembly-CSharp、NightOcean、UnityEngine.* 等待后续处理 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>OberoniaAurea_Frame.xml</DocumentationFile>
    <!-- 使用Path.GetFullPath求值，避免MSBuild直接解析[]为通配符 -->
    <OutputPath>$([System.IO.Path]::GetFullPath($(RimWorldModAssemblyDir)))</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Release\**" />
    <EmbeddedResource Remove="Release\**" />
    <None Remove="Release\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>E:\ProgramFiles\Steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>E:\ProgramFiles\Steam\steamapps\common\RimWorld\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NightOcean">
      <HintPath>..\..\NightOcean\bin\Release\NightOcean.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>E:\ProgramFiles\Steam\steamapps\common\RimWorld\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyNightOceanAssets" AfterTargets="Build">
    <Copy SourceFiles="..\..\NightOcean\bin\Release\NightOcean.dll"
          DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="..\..\NightOcean\bin\Release\NightOcean.xml"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('..\..\NightOcean\bin\Release\NightOcean.xml')" />
  </Target>
</Project>
